{
  "manifest_version": 3,
  "name": "Soulo Search Platform",
  "description": "Search for %s in a website’s search box, tap Add platform in the results, then save it in Soulo.",
  "version": "1.0.2",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Soulo Search Platform",
    "default_popup": "instructions.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start"
    }
  ]
}
