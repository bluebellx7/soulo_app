opt_out_usage
default_platform(:ios)
require "yaml"

APP_IDENTIFIER = "com.dkluge.Soulo"
PROJECT_CONFIG = YAML.load_file(File.expand_path("../project.yml", __dir__))
APP_VERSION = PROJECT_CONFIG.fetch("targets").fetch("Soulo").fetch("settings").fetch("base").fetch("MARKETING_VERSION").to_s
SCHEME = "Soulo"
PROJECT = "Soulo.xcodeproj"

platform :ios do
  desc "Run the complete unit-test suite"
  lane :tests do
    prepare_project
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: "iPhone 17 Pro",
      clean: true
    )
  end

  desc "Upload localized App Store metadata for the project version"
  lane :metadata do
    validate_release_metadata
    localized_metadata_path = sh("python3 #{File.expand_path('../scripts/export_fastlane_metadata.py', __dir__)}").strip
    upload_to_app_store(
      api_key: app_store_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: APP_VERSION,
      metadata_path: localized_metadata_path,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Build and upload the current project build to TestFlight"
  lane :beta do
    prepare_project
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      clean: true,
      export_method: "app-store"
    )
    upload_to_testflight(
      api_key: app_store_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and upload the project version without submitting it for review"
  lane :release do
    prepare_project
    localized_metadata_path = sh("python3 #{File.expand_path('../scripts/export_fastlane_metadata.py', __dir__)}").strip
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      clean: true,
      export_method: "app-store"
    )
    upload_to_app_store(
      api_key: app_store_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: APP_VERSION,
      metadata_path: localized_metadata_path,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  private_lane :prepare_project do
    validate_release_metadata
    sh("xcodegen generate")
  end

  private_lane :validate_release_metadata do
    scripts = File.expand_path("../scripts", __dir__)
    sh("python3 #{scripts}/export_metadata_json.py --check")
    sh("python3 #{scripts}/check_localization.py --strict")
  end

  private_lane :app_store_api_key do
    key_id = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]
    key_filepath = ENV["ASC_KEY_FILEPATH"]
    next nil if [key_id, issuer_id, key_filepath].any? { |value| value.to_s.empty? }

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath
    )
  end
end
