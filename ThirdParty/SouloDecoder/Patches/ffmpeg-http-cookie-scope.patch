+/* Keep cookies learned by the decoder at the issuing host. WebKit's
+ * explicitly scoped cookies are supplied separately through AVOptions. */
+static int store_response_cookie(HTTPContext *s, const char *value)
+{
+    char host[1024], path[MAX_URL_SIZE];
+    char *cookie, *slash;
+    int ret;
+    if (!s->location)
+        return 0;
+    av_url_split(NULL, 0, NULL, 0, host, sizeof(host), NULL,
+                 path, sizeof(path), s->location);
+    if (!host[0])
+        return 0;
+    path[strcspn(path, "?#")] = 0;
+    slash = strrchr(path, '/');
+    if (!slash || slash == path)
+        av_strlcpy(path, "/", sizeof(path));
+    else
+        *slash = 0;
+    AVDictionary *params = NULL;
+    ret = parse_set_cookie(value, &params);
+    const AVDictionaryEntry *path_param = av_dict_get(params, "path", NULL, 0);
+    if (ret < 0) {
+        av_dict_free(&params);
+        return ret;
+    }
+    cookie = av_asprintf("%s; domain=%s; host-only=1; path=%s", value, host,
+                         path_param && path_param->value[0] == '/' ? path_param->value : path);
+    av_dict_free(&params);
+    if (!cookie)
+        return AVERROR(ENOMEM);
+    ret = parse_cookie(s, cookie, &s->cookie_dict);
+    av_free(cookie);
+    return ret;
+}
